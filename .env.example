# Every environment variable the site and its admin read.
#
# Copy to .env.local for local work (it is gitignored) or pull the real values
# with `vercel env pull .env.local`. Nothing here is NEXT_PUBLIC_: none of it
# reaches the browser. The public site builds and runs with none of these set;
# it then shows the content shipped in lib/content.ts.

# --- From the Vercel integrations ------------------------------------------

# Neon Postgres connection string (Marketplace integration, region sin1).
# Without it the site uses the shipped content and the admin cannot sign in.
DATABASE_URL=

# Vercel Blob read-write token for the public store (social-yatri-media).
# The admin's uploads and the media checks need it.
BLOB_READ_WRITE_TOKEN=

# --- Set by hand -----------------------------------------------------------

# The admin's address: the site serves the admin at /<ADMIN_PATH>. 8 to 64
# letters, digits or hyphens, and not a word anyone would guess, because the
# repository is public. Unset means no admin at all. /cms is always a 404.
# Generate one: node -e "console.log('desk-' + crypto.randomBytes(6).toString('hex'))"
ADMIN_PATH=

# Signs the admin's session cookie. At least 32 characters of randomness;
# changing it signs everyone out.
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Salt for the hashed IP addresses stored with contact form submissions.
# Generate as above.
IP_HASH_SALT=

# Shared secret Vercel Cron sends to the scheduled clean-up routes (purging
# media deleted more than 30 days ago). Generate as above.
CRON_SECRET=

# --- Optional: contact form email -------------------------------------------

# With a Resend key, each contact form submission is also emailed. Without
# it, submissions are only kept in the admin's inbox.
RESEND_API_KEY=
# Where submissions are emailed, and the verified sender they come from.
CONTACT_TO=
CONTACT_FROM=

# --- Scripts only -----------------------------------------------------------

# Read by `npm run admin:create` instead of prompting, for non-interactive use.
# Never pass a password on the command line.
# ADMIN_PASSWORD=
