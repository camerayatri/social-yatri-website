# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The client's media. It is served from the Vercel Blob store (see
# lib/media.ts and scripts/upload-media.mjs); the copies under /public are
# for local development and are not part of the repository. The chrome that
# ships with the site stays tracked: /public/video/entry.mp4,
# /public/video/entry-av1.mp4, /public/video/taxi.mp4 and /public/img/noise.avif.
/public/video/reels/
/public/video/posters/
/public/img/*.jpg
/public/img/clients/
/public/img/covers/
/public/img/gallery/
/public/img/home-covers/
/public/img/services/
/public/img/work-covers/
